@model IEnumerable<ECommerceWeb.Models.CartItem>

@{
    ViewData["Title"] = "Alışveriş Sepetim";
    // Toplam sepet tutarını hesaplıyoruz
    decimal grandTotal = Model.Sum(item => item.TotalPrice);
}

<div class="container mt-5">
    <h2 class="mb-4"><i class="bi bi-bag-check-fill text-success"></i> Alışveriş Sepetiniz</h2>

    @if (!Model.Any())
    {
        <div class="alert alert-warning text-center py-5 shadow-sm" role="alert">
            <i class="bi bi-cart-x display-1 text-muted d-block mb-3"></i>
            <h4 class="fw-bold">Sepetiniz henüz boş!</h4>
            <p class="text-muted">Vitrindeki harika ürünlere göz atıp sepetinizi doldurmaya ne dersiniz?</p>
            <a asp-controller="Home" asp-action="Index" class="btn btn-primary btn-lg mt-3">Alışverişe Başla</a>
        </div>
    }
    else
    {
        <div class="row">
            <div class="col-lg-8 mb-4">
                <div class="card shadow-sm border-0">
                    <div class="table-responsive">
                        <table class="table table-hover align-middle mb-0">
                            <thead class="table-light">
                                <tr>
                                    <th scope="col" class="ps-4">Ürün</th>
                                    <th scope="col">Fiyat</th>
                                    <th scope="col" class="text-center">Adet</th>
                                    <th scope="col">Toplam</th>
                                    <th scope="col" class="pe-4"></th>
                                </tr>
                            <tbody>
                                @foreach (var item in Model)
                                {
                                    <tr>
                                        <td class="ps-4">
                                            <div class="d-flex align-items-center">
                                                @if (!string.IsNullOrEmpty(item.ImageUrl))
                                                {
                                                    <img src="~/images/@item.ImageUrl" class="rounded me-3 border" style="width: 60px; height: 60px; object-fit: cover;">
                                                }
                                                else
                                                {
                                                    <img src="https://via.placeholder.com/60?text=Yok" class="rounded me-3 border" style="width: 60px; height: 60px;">
                                                }
                                                <div>
                                                    <h6 class="mb-0 fw-bold">@item.ProductTitle</h6>
                                                </div>
                                            </div>
                                        </td>
                                        <td>@item.Price.ToString("C")</td>
                                        <td class="text-center fw-bold">@item.Quantity</td>
                                        <td class="fw-bold text-dark">@item.TotalPrice.ToString("C")</td>
                                        <td class="pe-4 text-end">
                                            <a asp-controller="Cart" asp-action="RemoveFromCart" asp-route-id="@item.ProductId" class="btn btn-sm btn-outline-danger" title="Ürünü Sil">
                                                <i class="bi bi-trash3-fill"></i> Sil
                                            </a>
                                        </td>
                                    </tr>
                                }
                            </tbody>
                        </table>
                    </div>
                </div>
            </div>

            <div class="col-lg-4">
                <div class="card shadow-sm border-0 p-4 bg-light">
                    <h4 class="fw-bold mb-4">Sipariş Özeti</h4>
                    <div class="d-flex justify-content-between mb-3 fs-5">
                        <span class="text-muted">Toplam Ürün:</span>
                        <span class="fw-bold">@Model.Sum(i => i.Quantity) Adet</span>
                    </div>
                    <hr>
                    <div class="d-flex justify-content-between mb-4">
                        <span class="fs-4 fw-bold">Genel Toplam:</span>
                        <span class="fs-4 fw-bold text-success">@grandTotal.ToString("C")</span>
                    </div>
                    <div class="d-grid gap-2">
                        <button class="btn btn-success btn-lg shadow-sm" onclick="alert('Tebrikler! Alışverişiniz başarıyla tamamlandı. (Bu kısım prototiptir)')">
                            Alışverişi Tamamla <i class="bi bi-arrow-right-short"></i>
                        </button>
                        <a asp-controller="Home" asp-action="Index" class="btn btn-outline-secondary">
                            Alışverişe Devam Et
                        </a>
                    </div>
                </div>
            </div>
        </div>
    }
</div>